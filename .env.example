# Copy this file to ".env" and fill in your own values.
# The real .env is git-ignored so secrets never end up in the repo.

# Flask session signing key (use any long random string)
SECRET_KEY=change-me-to-something-random

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=servus
DB_USER=postgres
DB_PASSWORD=postgres

# Connection pool size (optional, these are the defaults)
DB_POOL_MIN=1
DB_POOL_MAX=10
