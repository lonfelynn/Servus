# Copy this file to ".env" and fill in your own values.
# The real .env is git-ignored so secrets never end up in the repo.

# Flask session signing key (use any long random string).
# REQUIRED — the app refuses to start if this is unset.
SECRET_KEY=change-me-to-something-random

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=servus
DB_USER=postgres
DB_PASSWORD=postgres

# Connection pool size (optional, these are the defaults)
DB_POOL_MIN=1
DB_POOL_MAX=10

# Server bind (optional). Defaults: HOST=127.0.0.1, PORT=5000.
# FLASK_DEBUG defaults on for localhost, off otherwise.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1

# Send the session cookie only over HTTPS. Leave 0 for local http:// dev
# (a Secure cookie is dropped by the browser over plain HTTP and breaks login).
# Set to 1 in production behind HTTPS.
SESSION_COOKIE_SECURE=1
